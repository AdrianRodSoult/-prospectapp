# === General ===
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DATABASE_URL=sqlite:///./prospectapp.db

# === Google Places (opcional; sin esto, la app usa datos DEMO gratis) ===
# GOOGLE_PLACES_API_KEY=

# === IA: mock | anthropic | openai ===
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=800

# === Gmail OAuth (opcional; sin esto, se crean borradores simulados) ===
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# === Límites de coste ===
DAILY_SEARCH_LIMIT=50
MAX_RESULTS_PER_SEARCH=60

# === CORS ===
CORS_ORIGINS=http://localhost:3000
